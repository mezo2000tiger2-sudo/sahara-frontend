# Express API origin. The frontend makes no direct database connections.
BACKEND_API_URL=http://localhost:3000

# Frontend origin. Port 3001 avoids conflicting with the Express example.
AUTH_URL=http://localhost:3001

# Generate a random secret locally. Never expose it with NEXT_PUBLIC_.
AUTH_SECRET=

# Google OAuth client credentials used by the Auth.js provider.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth client credentials.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
